    "Apple's speech transcriber needs a language before recording starts. Automatic follows your iPhone preferences; it does not detect the language from the audio." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El transcriptor de Apple necesita un idioma antes de empezar a grabar. Automático sigue las preferencias del iPhone; no detecta el idioma a partir del audio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O transcritor da Apple precisa de um idioma antes do início da gravação. Automático segue as preferências do iPhone; ele não detecta o idioma pelo áudio."
          }
        }
      }
    },
