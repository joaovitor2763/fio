          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza un reemplazo para eliminarlo. Las reglas nuevas afectan a futuras transcripciones; las entradas existentes solo cambian cuando aplicas el vocabulario manualmente."
          }
