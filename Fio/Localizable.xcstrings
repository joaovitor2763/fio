    "Fio profile and insights" : {

    },
    "Fio will apply this on future transcriptions before creating a reflection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fio lo aplicará a futuras transcripciones antes de crear una reflexión."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fio aplicará isso nas próximas transcrições antes de criar uma reflexão."
          }
        }
      }
    },
    "For example: “Focus on decisions and recurring themes. Use direct language.” Fio still stays factual and never gives advice or invents details." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ejemplo: “Céntrate en las decisiones y los temas recurrentes. Usa un lenguaje directo.” Fio sigue ateniéndose a los hechos y nunca da consejos ni inventa detalles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por exemplo: “Dê foco às decisões e aos temas recorrentes. Use linguagem direta.” O Fio continua fiel aos fatos e nunca dá conselhos nem inventa detalhes."
          }
        }
      }
    },
    "Further observation" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra observación"
          }
        },
        "pt-BR" : {
